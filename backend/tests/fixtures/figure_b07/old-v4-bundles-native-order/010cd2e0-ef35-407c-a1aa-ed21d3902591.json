          "import matplotlib, matplotlib.pyplot as plt, numpy as np, textwrap, platform\nfrom matplotlib.font_manager import FontProperties\nfrom matplotlib.ticker import LogLocator, ScalarFormatter, FuncFormatter\nfrom PIL import Image\n\nout_png=\"/mnt/data/figure.png\"\nout_json=\"/mnt/data/result.json\"\n\nstyle=data[\"plot_config\"][\"style\"]\nW,H=style[\"width\"],style[\"height\"]\ndpi=300\nfigsize=(W/dpi,H/dpi)\nfont_path=\"/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc\"\nfont_prop=FontProperties(fname=font_path)\nfont_name=font_prop.get_name()\nfs=style[\"font_size\"]\n\nmatplotlib.rcParams[\"text.parse_math\"] = False\nmatplotlib.rcParams[\"axes.unicode_minus\"] = False\nmatplotlib.rcParams[\"font.size\"] = fs\n\nfig=plt.figure(figsize=figsize,dpi=dpi,facecolor=\"white\")\n# planned axes, leaving distinct title/annotation and caption areas\nax=fig.add_axes([0.16,0.40,0.76,0.36], facecolor=\"white\")\n\neffects=data[\"effects\"]\ny=np.arange(len(effects))[::-1]\ncolor=\"#0173B2\"\nfor yi,e in zip(y,effects):\n    est=e[\"estimate\"]; lo=e.get(\"ci_low\"); hi=e.get(\"ci_high\")\n    if lo is not None and hi is not None:\n        ax.errorbar(est, yi, xerr=[[est-lo],[hi-est]], fmt=\"o\",\n                    color=color, ecolor=color, elinewidth=2.2, capsize=6,\n                    markersize=8, markeredgecolor=\"white\", markeredgewidth=0.8,\n                    zorder=3)\n    else:\n        ax.plot(est,yi,\"o\",color=color,markersize=8,zorder=3)\n\nax.axvline(data[\"plot_config\"][\"reference_line\"], color=\"#666666\", linestyle=\"--\", linewidth=1.3, zorder=1)\nax.set_xscale(\"log\")\nvals=[]\nfor e in effects:\n    vals += [v for v in [e.get(\"ci_low\"),e.get(\"ci_high\"),e.get(\"estimate\")] if v is not None and v>0]\nvmin,vmax=min(vals+[data[\"plot_config\"][\"reference_line\"]]),max(vals+[data[\"plot_config\"][\"reference_line\"]])\nlogmin, logmax=np.log10(vmin),np.log10(vmax)\npad=max(0.25,(logmax-logmin)*0.18)\nax.set_xlim(10**(logmin-pad),10**(logmax+pad))\nax.set_ylim(-0.65, max(0.65, len(effects)-0.35))\nax.set_yticks(y)\nax.set_yticklabels([e[\"label\"] for e in effects], fontproperties=font_prop, fontsize=fs)\nax.set_xlabel(data[\"presentation\"][\"axes\"][\"x\"][\"label\"], fontproperties=font_prop, fontsize=fs, labelpad=12)\nax.set_ylabel(data[\"presentation\"][\"axes\"][\"y\"][\"label\"], fontproperties=font_prop, fontsize=fs, labelpad=12)\nax.tick_params(axis=\"both\", labelsize=fs)\nfor tick in ax.get_xticklabels():\n    tick.set_fontproperties(font_prop)\nax.grid(axis=\"x\",which=\"major\",color=\"#DDDDDD\",linewidth=0.8)\nax.grid(axis=\"x\",which=\"minor\",color=\"#EEEEEE\",linewidth=0.5)\nax.spines[\"top\"].set_visible(False); ax.spines[\"right\"].set_visible(False)\n\n# Scalar-style labels for common log ticks\nax.xaxis.set_major_locator(LogLocator(base=10))\nax.xaxis.set_minor_locator(LogLocator(base=10,subs=np.arange(2,10)*0.1))\nax.xaxis.set_major_formatter(FuncFormatter(lambda x,pos: f\"{x:g}\"))\n\ntitle_artist=fig.text(0.5,0.94,data[\"labels\"][\"title\"],ha=\"center\",va=\"top\",\n                      fontproperties=font_prop,fontsize=fs,fontweight=\"bold\")\nci_artist=fig.text(0.16,0.82,\"95%置信区间\",ha=\"left\",va=\"top\",\n                   fontproperties=font_prop,fontsize=fs,color=\"#333333\")\n\ncaption=data[\"labels\"][\"caption\"]\n# preserve exact characters; only add wrapping newlines\ncaption_wrapped=\"\\n\".join(textwrap.wrap(caption,width=83,break_long_words=False,break_on_hyphens=False))\ncap_artist=fig.text(0.08,0.245,caption_wrapped,ha=\"left\",va=\"top\",\n                    fontproperties=font_prop,fontsize=fs,linespacing=1.25)\n\nabbr_parts=[f'{a[\"term\"]}：{a[\"definition\"]}' for a in data[\"presentation\"][\"abbreviations\"]]\nabbr=\"缩略语：\"+\"；\".join(abbr_parts)\nabbr_wrapped=\"\\n\".join(textwrap.wrap(abbr,width=88,break_long_words=False,break_on_hyphens=False))\nabbr_artist=fig.text(0.08,0.075,abbr_wrapped,ha=\"left\",va=\"bottom\",\n                     fontproperties=font_prop,fontsize=fs,linespacing=1.2)\n\n# draw and collect bboxes\nfig.canvas.draw()\nrenderer=fig.canvas.get_renderer()\nbbox_info={}\nfor name,artist in [(\"title\",title_artist),(\"ci\",ci_artist),(\"caption\",cap_artist),(\"abbr\",abbr_artist),\n                    (\"xlabel\",ax.xaxis.label),(\"ylabel\",ax.yaxis.label)]:\n    b=artist.get_window_extent(renderer=renderer)\n    bbox_info[name]=(b.x0,b.y0,b.x1,b.y1)\nbbox_info\n",
