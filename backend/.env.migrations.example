# Copy to backend/.env.migrations; replace passwords locally, URL-encoded.
# Only explicit migration/import commands and isolated tests load this file.
# Runtime settings (environment/schema/host/database) must match backend/.env.
# Existing database owners remain the migration roles; runtime roles must differ.
PAPERASSIST_MIGRATION_DATABASE_URL=postgresql+psycopg://paperassist_app:REPLACE_LOCALLY@localhost:5432/paperassist_system
PAPERASSIST_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://paperassist_test:REPLACE_LOCALLY@localhost:5432/paperassist_system_test
