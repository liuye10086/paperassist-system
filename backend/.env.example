# Copy to backend/.env for local settings. Environment variables take precedence.
# .env is ignored by Git. Keep the key on the backend; never use a VITE_ variable.
# PostgreSQL is required. Replace placeholders locally; URL-encode passwords.
# Never use generic DATABASE_URL / TEST_DATABASE_URL (they may belong to another project).
PAPERASSIST_ENV=development
PAPERASSIST_DATABASE_URL=postgresql+psycopg://paperassist_app:REPLACE_LOCALLY@localhost:5432/paperassist_system
PAPERASSIST_TEST_DATABASE_URL=postgresql+psycopg://paperassist_test:REPLACE_LOCALLY@localhost:5432/paperassist_system_test
# Development schema. pytest replaces this with a new pa_test_<uuid32> for each integration test.
PAPERASSIST_DB_SCHEMA=public
# From backend/: .\.venv\Scripts\python.exe -m app.database upgrade
# Startup and health checks verify the schema; they never create/upgrade it.

OPENAI_API_KEY=
# Example supporting Code Interpreter. Use a model available to your API project.
OPENAI_MODEL=gpt-5.4

# Positive integers. Optional; these upload limits have defaults.
EXCEL_MAX_UPLOAD_BYTES=10485760
EXCEL_MAX_UNCOMPRESSED_BYTES=67108864
EXCEL_MAX_SHEETS=50
# Raw worksheet coordinates (including header / formatting cells).
EXCEL_MAX_ROWS=100000
EXCEL_MAX_COLUMNS=256
# Total scanned cell slots across all sheets, including blank positions.
EXCEL_MAX_CELLS=1000000

# File assets only, not the database. Relative to backend/; may also be an absolute directory.
PAPERASSIST_DATA_DIR=data
